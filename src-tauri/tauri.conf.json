{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Excalidraw",
  "version": "0.5.0",
  "identifier": "com.local.ai-excalidraw",
  "build": {
    "beforeDevCommand": "bun run dev -- --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Excalidraw",
        "width": 1440,
        "height": 940,
        "minWidth": 800,
        "minHeight": 600,
        "backgroundColor": "#ffffff",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "用自然语言创建和编辑手绘图表",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "excalidraw"
        ],
        "name": "Excalidraw 画布",
        "role": "Editor",
        "mimeType": "application/vnd.excalidraw+json"
      }
    ]
  }
}
